SITE_DOMAIN=gujianyanxue.online

# 示例默认没有试用账号。配置与邀请码格式见 ink_drama/README.md。
SFA_INK_INVITES='[]'
# 受邀账号登录后可直接调用服务器配置的模型，调用由模型账号计费。
SFA_INK_INVITE_REAL_GENERATION=1

# 可选。填写明确对试用者共享的示例项目 ID，以逗号分隔。
SFA_INK_SHARED_PROJECT_IDS=

# 可选。导入完整保国寺项目及其素材后，填写模板专用项目 ID。
SFA_INK_HERITAGE_BAOGUO_PROJECT_ID=

# 按实际选用的模型填至少一个服务商的密钥。
# 仅接入百炼时，用万相同时处理文生图与参考图生成。
SFA_MODEL_IMAGE_T2I=wan2.7-image
SFA_MODEL_IMAGE_IT2I=wan2.7-image
SFA_DASHSCOPE_API_KEY=
SFA_ARK_API_KEY=
SFA_OPENAI_API_KEY=
SFA_DEEPSEEK_API_KEY=
